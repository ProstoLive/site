---
---

<button type="button" class="theme-toggle" id="themeToggle" aria-label="Тема сайта">
	<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
		<path d="M20 12.5A8.5 8.5 0 1 1 11.5 4a7 7 0 0 0 8.5 8.5Z" />
	</svg>
</button>

<div class="theme-message" id="themeMessage" role="status" aria-live="polite">
	Тёмной темы на этом сайте никогда не будет.
</div>

<style>
	.theme-toggle {
		position: fixed;
		top: 16px;
		right: 16px;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--bg);
		color: var(--text);
		cursor: pointer;
		transition:
			color 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.theme-toggle:hover {
		color: var(--accent);
		background: rgba(0, 0, 0, 0.05);
	}

	.theme-message {
		position: fixed;
		top: 62px;
		right: 16px;
		z-index: 20;
		max-width: 240px;
		padding: 10px 14px;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--bg);
		color: var(--text);
		font-size: 14px;
		line-height: 1.5;
		text-align: right;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.25s ease,
			visibility 0s linear 0.25s;
	}

	.theme-message.visible {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.25s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-message {
			transition: none;
		}
	}
</style>

<script>
	const button = document.getElementById('themeToggle');
	const message = document.getElementById('themeMessage');

	const GRACE_MS = 3000;
	let hideTimer: ReturnType<typeof setTimeout> | null = null;

	function showMessage() {
		if (!message) return;
		if (hideTimer !== null) {
			clearTimeout(hideTimer);
		}
		message.classList.add('visible');
		hideTimer = setTimeout(() => {
			message.classList.remove('visible');
			hideTimer = null;
		}, GRACE_MS);
	}

	button?.addEventListener('click', showMessage);
</script>
