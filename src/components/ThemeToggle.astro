---
---

<button
	type="button"
	class="theme-toggle"
	id="themeToggle"
	aria-label="Тема сайта"
	aria-pressed="false"
>
	<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
		<path d="M20 12.5A8.5 8.5 0 1 1 11.5 4a7 7 0 0 0 8.5 8.5Z" />
	</svg>
</button>

<!-- pointer-events: none — оверлей визуально закрывает весь сайт, но клики
     сквозь него по-прежнему доходят до навбара, ссылок и самой кнопки -->
<div class="theme-overlay" id="themeOverlay" aria-hidden="true">
	<p>Вы хотели тёмную тему, верно?</p>
</div>

<style>
	.theme-toggle {
		position: fixed;
		top: 16px;
		right: 16px;
		z-index: 30;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--bg);
		color: var(--text);
		cursor: pointer;
		transition:
			color 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.theme-toggle:hover {
		color: var(--accent);
		background: rgba(0, 0, 0, 0.05);
	}

	.theme-toggle[aria-pressed='true'] {
		border-color: var(--accent);
		color: var(--accent);
	}

	.theme-overlay {
		position: fixed;
		inset: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		background: #000;
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.3s ease,
			visibility 0s linear 0.3s;
	}

	.theme-overlay.visible {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.3s ease;
	}

	.theme-overlay p {
		margin: 0;
		max-width: 30ch;
		color: #fff;
		font-size: 28px;
		font-weight: 600;
		line-height: 1.4;
		text-align: center;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-overlay {
			transition: none;
		}
	}

	@media screen and (max-width: 480px) {
		.theme-overlay p {
			font-size: 22px;
		}
	}
</style>

<script>
	const button = document.getElementById('themeToggle');
	const overlay = document.getElementById('themeOverlay');

	let active = false;

	button?.addEventListener('click', () => {
		active = !active;
		overlay?.classList.toggle('visible', active);
		button.setAttribute('aria-pressed', String(active));
	});
</script>
