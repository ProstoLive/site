---
---

<footer id="site-footer">
	<div class="contacts" id="footer-contacts"></div>
	<nav class="webring" aria-label="Вебринг">
		<p class="webring-caption">Посетите моих друзей по интернету</p>
		<div class="webring-links">
			<a href="https://webring.alivetech.org/prev?site=https://artredkiy.com">‹ Предыдущий</a>
			<a class="webring-home" href="https://webring.alivetech.org/">Что это?</a>
			<a href="https://webring.alivetech.org/random">Мне повезёт</a>
			<a href="https://webring.alivetech.org/next?site=https://artredkiy.com">Следующий ›</a>
		</div>
	</nav>
	<nav class="footer-nav" aria-label="Разделы сайта">
		<a href="/blog">Блог</a>
		<a href="/about">Обо мне</a>
		<a href="/now">Сейчас</a>
	</nav>
</footer>

<style>
	/* три колонки 1fr | auto | 1fr: блок вебкольца всегда ровно по центру,
	   слева контакты, справа ссылки на разделы сайта */
	#site-footer {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 24px;
		padding: 24px 16px;
		margin-top: 4vh;
		border-top: 1px solid var(--border);
	}

	.contacts {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 4px;
	}

	.footer-nav {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 4px;
	}

	.webring {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding: 16px 20px;
		border: 1px solid var(--border);
		border-radius: 12px;
	}

	@media (max-width: 720px) {
		#site-footer {
			grid-template-columns: 1fr;
			justify-items: center;
		}

		.contacts,
		.footer-nav {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: center;
		}
	}

	/* как подписи карточек на главной (.highlight-text p в src/pages/index.astro) */
	.webring-caption {
		margin: 0;
		font-size: 16px;
		color: var(--text);
	}

	.webring-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px;
	}

	.webring-links a {
		padding: 4px 12px;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 13px;
		color: var(--text);
		text-decoration: none;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.webring-links a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.webring-links .webring-home {
		color: var(--accent);
		font-weight: 500;
	}

	/* .contact-link создаётся в рантайме скриптом (см. ниже), поэтому не
	   получает Astro-скоуп (data-astro-cid-*) на этапе сборки — без
	   :global() это правило его бы просто не видело */
	:global(.contact-link),
	.footer-nav a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 14px;
		border-radius: 999px;
		font-size: 14px;
		color: var(--muted);
		text-decoration: none;
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	:global(.contact-link:hover),
	.footer-nav a:hover {
		color: var(--accent);
		background: rgba(0, 0, 0, 0.05);
	}

	:global(.contact-icon) {
		display: flex;
		flex: none;
	}

	:global(.contact-icon svg) {
		display: block;
	}
</style>

<script>
	// контакты собираются в DOM только из JS, чтобы в отданном сервером HTML
	// не было ни одного адреса/ссылки текстом — обычные боты-сборщики
	// e-mail это не выполняют (см. такой же приём на главной странице)
	type ContactDef = {
		label: string;
		href?: string;
	};

	const contacts: ContactDef[] = [
		{ label: 'Email', href: atob('bWFpbHRvOnJ1ZHlha2FzQGFsaXZldGVjaC5vcmc=') },
		{ label: 'Telegram', href: atob('aHR0cHM6Ly90Lm1lL2FydHJlZGtpeQ==') },
		{ label: 'GitHub', href: atob('aHR0cHM6Ly9naXRodWIuY29tL1Byb3N0b0xpdmU=') },
	];

	// иконки — просто маркировка типа контакта, не сам контакт, поэтому
	// хранить их как обычную статичную разметку не противоречит цели
	// скрипта (не дать боту распарсить сам адрес/ссылку из исходника)
	const ICONS: Record<string, string> = {
		Email:
			'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
		Telegram:
			'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7Z"/></svg>',
		GitHub:
			'<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5Z"/></svg>',
	};

	const container = document.getElementById('footer-contacts');

	if (container) {
		for (const { label, href } of contacts) {
			const el = document.createElement(href ? 'a' : 'span');
			el.className = 'contact-link';

			const iconEl = document.createElement('span');
			iconEl.className = 'contact-icon';
			iconEl.innerHTML = ICONS[label] ?? '';

			const labelEl = document.createElement('span');
			labelEl.textContent = label;

			el.append(iconEl, labelEl);

			if (href) {
				const link = el as HTMLAnchorElement;
				link.href = href;
				link.target = '_blank';
				link.rel = 'noopener noreferrer';
			}

			container.append(el);
		}
	}
</script>
