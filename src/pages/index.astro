---
import Layout from '../layouts/Layout.astro';

const tags = [
	'Видеоигры',
	'Искусство',
	'Прогулки',
	'Дискуссии на спорные темы',
	'Распределённые системы',
	'Образование',
	'AI в образовании',
	'Программирование',
	'CRDT',
	'Мораль',
	'Политическая философия',
];

// достаточно повторов, чтобы одна половина трека гарантированно
// перекрывала ширину контейнера на любом разумном экране
const REPEATS = 1;

function buildHalf(offset: number) {
	const rotated = [...tags.slice(offset), ...tags.slice(0, offset)];
	return Array.from({ length: REPEATS }, () => rotated).flat();
}

// каждый ряд = [половина, та же половина] — чтобы translateX(-50%)
// сходился без скачка, дублируемая часть должна быть побайтово идентична
const rowSpeeds = [50, 67, 62]; // секунд на полный цикл, свои для каждого ряда
const rows = rowSpeeds.map((speed, i) => {
	const half = buildHalf(i);
	return { tags: [...half, ...half], speed };
});
---

<Layout>
	<main>
		<section class="profile">
			<div class="profile-header">
				<img class="portrait" src="/avatar.avif" alt="Артём" width="220" height="280" />

				<p class="lead">
					<span class="prompt">&gt;</span> Привет! Меня зовут Артём, я студент, программист,
					активист, и член других социальных групп.
					<br />
					Но прежде всего я <strong>человек</strong>.<span class="cursor" aria-hidden="true"></span>
				</p>
			</div>

			<div class="page-content">
				<div id="highlights">
					<article class="highlight">
						<div class="highlight-text">
							<h2>Вы HR?</h2>
							<p>Ознакомьтесь с моим резюме.</p>
						</div>
						<div class="links">
							<a href="/cv-en.pdf">CV (EN)</a>
							<a href="/cv-ru.pdf">CV (RU)</a>
						</div>
					</article>

					<article class="highlight">
						<div class="highlight-text">
							<h2>Вам интересна моя жизнь?</h2>
							<p>Зайдите в мой блог.</p>
						</div>
						<a class="arrow" href="/blog">Читать</a>
					</article>

					<article class="highlight">
						<div class="highlight-text">
							<h2>Мы не знакомы?</h2>
							<p>Давайте я расскажу о себе и мы это исправим.</p>
						</div>
						<a class="arrow" href="/about">Обо мне</a>
					</article>
				</div>

				<p>
					Я учусь в Саратовском государственном университете имени Н. Г. Чернышевского, активно
					интересуюсь IT и стараюсь заинтересовывать в этой сфере других людей.
				</p>

				<p>Вот примерный список того, что мне очень нравится:</p>

				<div class="carousel">
					{
						rows.map((row, i) => (
							<div
								class={`row ${i % 2 === 0 ? 'row-a' : 'row-b'}`}
								style={`--duration: ${row.speed}s`}
							>
								<ul class="track">
									{row.tags.map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>

				<p>Это пространство было создано мной как универсальное решение следующих проблем:</p>
				<div class="reasons">
					<div class="reason">
						<span class="num">01</span>
						<p>
							Я хотел иметь собственный сайт-визитку в сети, чтобы не зависеть от сторонних платформ,
							хранящих мои данные.
						</p>
					</div>
					<div class="reason">
						<span class="num">02</span>
						<p>
							Я хотел иметь место, где смогу свободно писать и делиться своими мыслями, так как канал
							в любой из соцсетей не устраивает меня своим ограниченным функционалом.
						</p>
					</div>
					<div class="reason">
						<span class="num">03</span>
						<p>
							Я хотел иметь песочницу, в которой смогу лепить замки любых форм и масштабов и делиться
							ими с людьми.
						</p>
					</div>
				</div>

				<p>
					Я также выступаю за Local-first, Open-source, а это пространство реализует принцип POSSE
					(Publish on own site, syndicate elsewhere).
				</p>

				<h2>Давайте общаться!</h2>
				<p>
					Это пространство создано в том числе для поиска единомышленников и просто новых знакомств,
					так что будьте вольны написать мне через любой канал связи. Кстати, вот они:
				</p>
				<div class="contacts" id="contacts"></div>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 860px;
		margin: 8vh auto 0;
		padding: 16px;
	}

	#highlights {
		display: flex;
		flex-direction: column;
		margin: 2em 0 3em;
	}

	.highlight {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 20px 0;
		border-top: 1px solid var(--border);
	}

	.highlight:last-child {
		border-bottom: 1px solid var(--border);
	}

	#highlights h2 {
		font-size: 19px;
		font-weight: 700;
		color: var(--accent);
		margin: 0 0 4px;
	}

	.highlight-text p {
		margin: 0;
		color: var(--text);
		font-size: 16px;
	}

	.links {
		display: flex;
		gap: 16px;
		flex: none;
	}

	.highlight a {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 3px;
		font-size: 16px;
		white-space: nowrap;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}

	.highlight a:hover {
		color: var(--accent-deep);
		text-decoration-color: var(--accent-deep);
	}

	a.arrow::after {
		content: ' →';
	}

	@media screen and (max-width: 480px) {
		.highlight {
			flex-direction: column;
			align-items: flex-start;
			gap: 8px;
		}
	}

	/* --- профиль (перенесено со страницы /about) --- */

	.profile-header {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 40px;
		align-items: center;
		padding-bottom: 1.2em;
		margin-bottom: 1.5em;
		border-bottom: 1px solid var(--border);
	}

	.portrait {
		width: 220px;
		height: 280px;
		object-fit: cover;
		border: 1px solid var(--ink);
		border-radius: 12px;
		animation: reveal 0.6s ease-out both;
	}

	/* появление страницы: сначала портрет, потом текст рядом с ним, потом всё остальное */
	@keyframes reveal {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.page-content {
		animation: reveal 0.6s ease-out 1s both;
	}

	@media (prefers-reduced-motion: reduce) {
		.portrait,
		.lead,
		.page-content {
			animation: none;
		}
	}

	.profile h2 {
		font-size: 19px;
		font-weight: 700;
		color: var(--accent);
		margin: 2.5em 0 0.6em;
	}

	.carousel {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin: 0 0 2em;
		overflow: hidden;
		mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			black 10%,
			black 90%,
			transparent
		);
	}

	.row {
		overflow: hidden;
	}

	.track {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
		width: max-content;
	}

	.row-a .track {
		animation: scroll-left var(--duration, 60s) linear infinite;
	}

	.row-b .track {
		animation: scroll-right var(--duration, 60s) linear infinite;
	}

	.track li {
		flex: none;
		margin-right: 8px;
		padding: 6px 14px;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 14px;
		color: var(--text);
		white-space: nowrap;
	}

	@keyframes scroll-left {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@keyframes scroll-right {
		from {
			transform: translateX(-50%);
		}
		to {
			transform: translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track {
			animation: none;
		}
	}

	p {
		color: var(--text);
		font-size: 19px;
		line-height: 1.7;
		margin: 0 0 1.2em;
	}

	.lead {
		font-size: 26px;
		line-height: 1.5;
		color: var(--ink);
		font-weight: 400;
		margin: 0;
		animation: reveal 0.6s ease-out 0.5s both;
	}

	.prompt {
		font-family: var(--font-mono);
		color: var(--muted);
	}

	.cursor {
		display: inline-block;
		width: 0.5em;
		height: 1em;
		margin-left: 4px;
		background: var(--ink);
		vertical-align: text-bottom;
		animation: blink 1s step-end infinite;
	}

	@keyframes blink {
		0%,
		50% {
			opacity: 1;
		}
		50.01%,
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}

	.lead strong {
		font-weight: 700;
		color: var(--ink);
	}

	.reasons {
		margin-bottom: 1.5em;
	}

	.reason {
		display: flex;
		gap: 20px;
		padding: 20px 0;
		border-top: 1px solid var(--border);
	}

	.reason:last-child {
		border-bottom: 1px solid var(--border);
	}

	.num {
		flex: none;
		font-size: 19px;
		font-weight: 700;
		color: var(--ink);
	}

	.reasons p {
		font-size: 19px;
		line-height: 1.7;
		margin: 0;
	}

	@media screen and (max-width: 480px) {
		.reason {
			gap: 12px;
		}
	}

	@media screen and (max-width: 640px) {
		.profile-header {
			grid-template-columns: 1fr;
		}

		.portrait {
			width: 160px;
			height: 200px;
		}
	}

	.contacts {
		display: flex;
		flex-direction: column;
	}

	/* .contact* — блоки создаются в рантайме скриптом (см. ниже), поэтому
	   не получают Astro-скоуп (data-astro-cid-*) на этапе сборки — без
	   :global() эти правила их бы просто не видели */
	:global(.contact) {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		padding: 16px 0;
		border-top: 1px solid var(--border);
		text-decoration: none;
		color: inherit;
	}

	:global(.contact:last-child) {
		border-bottom: 1px solid var(--border);
	}

	:global(.contact-label) {
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--muted);
	}

	:global(.contact-value) {
		font-size: 19px;
		color: var(--accent);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 3px;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}

	:global(.contact:hover .contact-value) {
		color: var(--accent-deep);
		text-decoration-color: var(--accent-deep);
	}

	@media screen and (max-width: 480px) {
		:global(.contact) {
			flex-direction: column;
			align-items: flex-start;
			gap: 4px;
		}
	}
</style>

<script>
	// контакты собираются в DOM только из JS, чтобы в отданном сервером HTML
	// (и в исходнике этого скрипта тоже) не было ни одного адреса/ссылки
	// текстом — обычные боты-сборщики e-mail это не выполняют
	type ContactDef = {
		label: string;
		value: string;
		href?: string;
	};

	const contacts: ContactDef[] = [
		{ label: 'Email', value: 'Скоро' },
		{ label: 'Telegram', value: '@artredkiy', href: atob('aHR0cHM6Ly90Lm1lL2FydHJlZGtpeQ==') },
		{
			label: 'GitHub',
			value: 'github.com/ProstoLive',
			href: atob('aHR0cHM6Ly9naXRodWIuY29tL1Byb3N0b0xpdmU='),
		},
	];

	const container = document.getElementById('contacts');

	if (container) {
		for (const { label, value, href } of contacts) {
			const row = document.createElement(href ? 'a' : 'div');
			row.className = 'contact';

			if (href) {
				const link = row as HTMLAnchorElement;
				link.href = href;
				link.target = '_blank';
				link.rel = 'noopener noreferrer';
			}

			const labelEl = document.createElement('span');
			labelEl.className = 'contact-label';
			labelEl.textContent = label;

			const valueEl = document.createElement('span');
			valueEl.className = 'contact-value';
			valueEl.textContent = value;

			row.append(labelEl, valueEl);
			container.append(row);
		}
	}
</script>
