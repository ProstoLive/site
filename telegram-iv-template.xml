<?xml version="1.0" encoding="utf-8"?>
<html>
<head>
    <template
        site_name="Блог Артёма"
        site_name_regex=""
    ></template>
</head>
<body>
    <essential>
        <property name="title">
            <xpath expr="//h1"/>
        </property>

        <property name="subtitle">
            <xpath expr="//meta[@name='description']/@content"/>
        </property>

        <property name="author">
            <fixed value=".redkiy"/>
        </property>

        <property name="published_date">
            <xpath expr="//meta[@property='article:published_time']/@content"/>
        </property>

        <property name="cover">
            <xpath expr="//meta[@property='og:image']/@content"/>
        </property>

        <property name="body">
            <xpath expr="//div[@class='content']"/>
        </property>
    </essential>

    <!-- KaTeX рендерит формулу дважды: невидимый MathML-фолбэк (с исходным
         TeX внутри <annotation>) и абсолютно позиционированные HTML-спаны
         для визуала. IV не умеет в произвольный inline-CSS, поэтому визуал
         вырезаем — остаётся читаемый текст формулы вместо мусора из спанов -->
    <div>
        <xpath expr="//span[@class='katex-html']"/>
        <remove_tag/>
    </div>
</body>
</html>
